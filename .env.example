# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_PORT_HOST=5432
# Optional single connection string override for production/PaaS deployments:
# DATABASE_URL=postgres://postgres:postgres@db:5432/app

# Django / DRF
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# In Hetzner prod, include your public origin (e.g., http://<server-ip>:3000 or https://example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_TITLE=Praktoteka API

# Service Ports
# On Hetzner prod (compose.prod.yaml), only FRONTEND_PORT is published (open range: 3000-3100)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Next.js Frontend
# Leave empty to proxy /api, /admin, and /static through Next.js on a single port (recommended).
# Set only if serving the Django API from a separate public origin.
NEXT_PUBLIC_API_URL=
# Set to true on WSL2/macOS if file watching misses edits:
WATCHPACK_POLLING=false

# Optional Google Gemini AI (deterministic rule-based fallback used when empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
GOOGLE_GENAI_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Real harvesting: production worker runs continuously; dev opt-in: --profile ingestion
# Seconds between batches; minimum 60, 10 source candidates per channel by default.
INGESTION_INTERVAL_SECONDS=3600
